{
  "name": "mashcode",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter @mashcode/web dev",
    "dev:api": "bun --filter @mashcode/api dev",
    "dev:judge": "bun --filter @mashcode/judge-worker dev",
    "dev:ai": "bun --filter @mashcode/ai-worker dev",
    "typecheck": "bun --filter './apps/*' typecheck && bun --filter './packages/*' typecheck",
    "db:generate": "bun --filter @mashcode/db generate",
    "db:migrate": "bun --filter @mashcode/db migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
